# Set these as environment variables for the API; do not commit a real secret.
# Generate one, for example: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
Jwt__Secret=replace-with-a-random-secret-of-at-least-32-bytes
Jwt__Issuer=Poulet.Api
Jwt__Audience=Poulet.Web
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# Comma-free JSON/config array is not supported in environment variables; configure repeated
# allowed origins through deployment configuration, or omit this for same-origin deployments.
# Cors__AllowedOrigins__0=https://app.example.com

# Required only when provisioning the first production administrator.
# Seed__AdminPassword=choose-a-strong-initial-password
